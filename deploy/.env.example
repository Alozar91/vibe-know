# Пароли и секреты — НЕ в репозитории (HLD §3.2): скопируйте в .env и заполните своими значениями.

# --- PostgreSQL (один экземпляр: БД kb + отдельная БД keycloak, HLD §3.2) ---
POSTGRES_USER=kb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kb
KEYCLOAK_DB=keycloak

# --- Keycloak ---
# Учётная запись начального администратора Keycloak (bootstrap, не СА системы)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Секреты клиентов (подставляются в realm-импорт через ${VAR})
KB_API_CLIENT_SECRET=change-me
KB_CLI_CLIENT_SECRET=change-me
# Пароль тестовых пользователей realm (ivanov/petrov/sidorova): >= 8 символов, не совпадает с именем
KB_TEST_PASSWORD=Testpass1

# --- Silo (CAS-хранилище, S3 API) ---
# Минимум 3 символа имя / 8 символов пароль (проверяет silo при старте)
SILO_ROOT_USER=kb-storage
SILO_ROOT_PASSWORD=change-me
# Бакет для объектов CAS создаётся сервисом silo-init
SILO_BUCKET=kb-files

# --- Приложение ---
LOG_LEVEL=INFO

# --- Тестовая регистрация (НЕ для продуктива) ---
# 1/true — после входа пользователь без ролей может один раз выбрать роль
# (Читатель/Автор/Рецензент/Публикатор). На продуктиве переменную не задавать.
KB_TEST_REGISTRATION=

# --- Ротация логов контейнеров (HLD §8.3): лимит на контейнер = LOG_MAX_SIZE × LOG_MAX_FILE ---
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# --- Резервное копирование (NFR-012, этап 11) ---
# Пароль шифрования restic (снапшоты тома silo). Смена = старые снапшоты нечитаемы.
BACKUP_RESTIC_PASSWORD=change-me
# Интервал цикла копирования, сек (86400 = раз в сутки; полная копия — по воскресеньям)
BACKUP_INTERVAL_SECONDS=86400

# --- Публичный адрес стенда ---
# Пусто — локальный стенд (localhost). Для облака:
#   KB_PUBLIC_URL=http://1.2.3.4              — без TLS, Keycloak напрямую :8080
#   KB_PUBLIC_URL=https://merch-vibe.ru       — TLS за nginx (README §5), Keycloak по /auth
# Задаёт: redirectUris realm, CORS api, адрес Keycloak в SPA (build-arg nginx).
KB_PUBLIC_URL=
# Адрес Keycloak (issuer) — вычисляется из KB_PUBLIC_URL:
#   http://IP           → KC_HOSTNAME_URL=http://IP:8080
#   https://домен       → KC_HOSTNAME_URL=https://домен/auth
KC_HOSTNAME_URL=

# --- Зеркало PyPI для сборки api/worker (опционально) ---
# Если при сборке «Failed to download ... files.pythonhosted.org ... timed out» —
# CDN PyPI недоступен с сервера; указать зеркало (URL до simple-индекса!), например:
#   UV_PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
#   UV_PYPI_MIRROR=https://mirrors.aliyun.com/pypi/simple
# Пусто — официальный PyPI. Версии пакетов резолвятся из pyproject.toml
# при каждой сборке (uv.lock в репозитории не хранится).
UV_PYPI_MIRROR=
