# Пароли и секреты — НЕ в репозитории (HLD §3.2): скопируйте в .env и заполните своими значениями.

# --- PostgreSQL (один экземпляр: БД kb + отдельная БД keycloak, HLD §3.2) ---
POSTGRES_USER=kb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kb
KEYCLOAK_DB=keycloak

# --- Keycloak ---
# Учётная запись начального администратора Keycloak (bootstrap, не СА системы)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Секреты клиентов (подставляются в realm-импорт через ${VAR})
KB_API_CLIENT_SECRET=change-me
KB_CLI_CLIENT_SECRET=change-me
# Пароль тестовых пользователей realm (ivanov/petrov/sidorova): >= 8 символов, не совпадает с именем
KB_TEST_PASSWORD=Testpass1

# --- Silo (CAS-хранилище, S3 API) ---
# Минимум 3 символа имя / 8 символов пароль (проверяет silo при старте)
SILO_ROOT_USER=kb-storage
SILO_ROOT_PASSWORD=change-me
# Бакет для объектов CAS создаётся сервисом silo-init
SILO_BUCKET=kb-files

# --- Приложение ---
LOG_LEVEL=INFO

# --- Тестовая регистрация (НЕ для продуктива) ---
# 1/true — после входа пользователь без ролей может один раз выбрать роль
# (Читатель/Автор/Рецензент/Публикатор). На продуктиве переменную не задавать.
KB_TEST_REGISTRATION=

# --- MCP-сервер (RAG, шаг 5) ---
# Read-only тулы kb_search/kb_groups для ИИ-агентов: POST /api/v1/mcp
# (streamable HTTP, JSON). Аутентификация — Bearer-токен Keycloak; права
# агента = права его учётной записи (предикат §3.2 LLD). 0/false — выключить.
KB_MCP_ENABLED=true

# --- RAG: векторная индексация (пост-MVP шаг [7], LLD §7.7) ---
# Embedding-провайдер по OpenAI-совместимому API (POST {base_url}/v1/embeddings).
# Пустой KB_RAG_EMBEDDING_BASE_URL — конвейер выключен (RAG-поиск отвечает
# 409 RAG_EMBEDDING_NOT_CONFIGURED; обычный полнотекстовый работает).
# base_url — БЕЗ /v1 на конце (клиент добавляет сам).
KB_RAG_EMBEDDING_BASE_URL=
KB_RAG_EMBEDDING_API_KEY=
# Модель и размерность. ВНИМАНИЕ: размерность фиксируется миграцией 0011 при
# первом старте (столбец vector(DIM)); смена модели/размерности позже =
# новая миграция + полный переиндекс (LLD §7.7). Значения должны совпадать
# со всеми предыдущими запусками стенда.
KB_RAG_EMBEDDING_MODEL=text-embedding-3-small
KB_RAG_EMBEDDING_DIM=1536
# Таймаут запроса к провайдеру, сек; чанков в одном запросе (32–64)
KB_RAG_EMBEDDING_TIMEOUT=30
KB_RAG_EMBEDDING_BATCH=32


# --- Ротация логов контейнеров (HLD §8.3): лимит на контейнер = LOG_MAX_SIZE × LOG_MAX_FILE ---
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# --- Резервное копирование (NFR-012, этап 11) ---
# Пароль шифрования restic (снапшоты тома silo). Смена = старые снапшоты нечитаемы.
BACKUP_RESTIC_PASSWORD=change-me
# Интервал цикла копирования, сек (86400 = раз в сутки; полная копия — по воскресеньям)
BACKUP_INTERVAL_SECONDS=86400

# --- Публичный адрес стенда ---
# Пусто — локальный стенд (localhost). Для облака:
#   KB_PUBLIC_URL=http://1.2.3.4              — без TLS, Keycloak напрямую :8080
#   KB_PUBLIC_URL=https://merch-vibe.ru       — TLS за nginx (README §5), Keycloak по /auth
# Задаёт: redirectUris realm, CORS api, адрес Keycloak в SPA (build-arg nginx).
KB_PUBLIC_URL=
# Адрес Keycloak (issuer) — вычисляется из KB_PUBLIC_URL:
#   http://IP           → KC_HOSTNAME_URL=http://IP:8080
#   https://домен       → KC_HOSTNAME_URL=https://домен/auth
KC_HOSTNAME_URL=

# --- База приложения: подпуть (опционально) ---
# Приложение по подпути, например /know → http://IP/know (nginx отдаёт SPA
# из /know/, redirect_uri Keycloak матчится шаблоном ${KB_PUBLIC_URL}/*).
# Пусто — приложение в корне. Смена → docker compose build nginx.
VITE_APP_BASE=

# --- PKCE-метод клиента kb-spa (опционально, дефолт S256) ---
# SPA использует S256, когда доступен crypto.subtle (secure context: HTTPS
# или localhost); на http://IP или http://домен он недоступен — SPA шлёт
# plain. Политика realm должна совпадать: http-стенд → KB_PKCE_METHOD=plain,
# HTTPS (secure context вернётся) → S256. Смена → down -v (переимпорт realm).
KB_PKCE_METHOD=

# --- Зеркало PyPI для сборки api/worker (опционально) ---
# Обычный вариант — пусто (официальный PyPI). Зеркало нужно, только если сборка
# падает с «files.pythonhosted.org ... timed out»; URL до simple-индекса:
#   UV_PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
#   UV_PYPI_MIRROR=https://mirrors.aliyun.com/pypi/simple
UV_PYPI_MIRROR=
